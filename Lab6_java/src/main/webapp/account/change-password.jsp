<%@ page language="java"
    contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Đổi mật khẩu</title>
</head>
<body>

<h2>Đổi mật khẩu</h2>

<form>
    Mật khẩu hiện tại: <input name="currentPassword" type="password"><br><br>
    Mật khẩu mới: <input name="newPassword" type="password"><br><br>
    Xác nhận mật khẩu mới: <input name="confirmPassword" type="password"><br><br>
    <button>Đổi mật khẩu</button>
</form>

</body>
</html>
